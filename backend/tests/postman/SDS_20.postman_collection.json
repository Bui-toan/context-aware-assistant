              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Có 3 field: meaning, explanation, examples\", () => {\r\n    const json = pm.response.json();\r\n    pm.expect(json).to.have.property(\"meaning\");\r\n    pm.expect(json).to.have.property(\"explanation\");\r\n    pm.expect(json).to.have.property(\"examples\");\r\n    pm.expect(json.examples).to.be.an(\"array\");\r\n});"
            ]
          }
        }
