		{
			"name": "2. Explain API",
			"item": [
				{
					"name": "POST /api/explain - Valid (Tiếng Việt)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
									"pm.test(\"Có 3 field: meaning, explanation, examples\", () => {\r",
									"    const json = pm.response.json();\r",
									"    pm.expect(json).to.have.property(\"meaning\");\r",
									"    pm.expect(json).to.have.property(\"explanation\");\r",
									"    pm.expect(json.examples).to.be.an(\"array\");\r",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Extension-Token", "value": "{{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"text\": \"machine learning\",\n  \"context\": \"Machine learning is a subset of AI.\",\n  \"language\": \"vi\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/explain",
							"host": ["{{baseUrl}}"],
							"path": ["api", "explain"]
						}
					},
					"response": []
				},
