# AI Provider
AI_PROVIDER_NAME=gemini
GEMINI_API_KEY=key1,key2,key3
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
AI_TIMEOUT=30

# ===== Embedding =====
EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2

# ===== Business limits (sẽ chốt ở Phase 15) =====
MAX_CONTEXT_LENGTH=500
MAX_BLOCKS=300
SIMILARITY_THRESHOLD=0.75

# ===== Server =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*